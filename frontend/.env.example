# SmartMENA frontend (Next.js) environment.
# Backend base URL. Must include /api suffix because the client appends paths directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Optional: pin a specific workspace UUID. Leave blank to auto-resolve "demo".
NEXT_PUBLIC_WORKSPACE_ID=

# Supabase auth (browser-side). Use the *anon* / publishable key, NOT the service role.
# Find these at: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Born2Hike demo credentials — used by the "Try the demo" button on /login.
# Create the user once via:  npm run seed:demo  (in /backend)
NEXT_PUBLIC_DEMO_EMAIL=demo@born2hike.com
NEXT_PUBLIC_DEMO_PASSWORD=Born2Hike2026!
