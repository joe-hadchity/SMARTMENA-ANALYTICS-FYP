PORT=4000
NODE_ENV=development

# Internal FastAPI ML service base URL
ML_SERVICE_URL=http://localhost:8000

# CORS origin for a future frontend (use * for local dev)
CORS_ORIGIN=*

# Supabase (project: qnplnwadnbvcovaudmoq)
# SERVER-SIDE ONLY. Never expose the service role key to the browser.
# Find it at: Supabase Dashboard -> Project Settings -> API -> "service_role" secret.
SUPABASE_URL=https://qnplnwadnbvcovaudmoq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFucGxud2FkbmJ2Y292YXVkbW9xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NjY2ODgzOCwiZXhwIjoyMDkyMjQ0ODM4fQ.RwDkqvZkWOVPAoxf4rPVbQO_s80ql8zkI16wm6zO36M

# ---------------------------------------------------------------------
# Azure OpenAI (optional)
# ---------------------------------------------------------------------
# If any of these are missing, the AI copilot layer (assistant, caption
# studio, report narrative) is disabled at boot, but
# the rest of the backend keeps running. Set all four to turn it on.
#
# ENDPOINT:   base URL of the Azure OpenAI resource, e.g.
#             https://my-resource.openai.azure.com
# API_KEY:    one of the keys from Azure portal -> Resource -> Keys
# DEPLOYMENT: the deployment name (NOT the model name), e.g. "gpt-4o-mini"
# API_VERSION: Azure API version, default 2024-08-01-preview
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
DEMO_MODE=false

# Per-workspace monthly soft cap on LLM tokens (prompt + completion).
# Default is 100k; exceeding it returns a 429 with an upgrade-CTA payload.
LLM_MONTHLY_TOKEN_BUDGET=100000

# ---------------------------------------------------------------------
# Trend intelligence discovery search (optional)
# ---------------------------------------------------------------------
TREND_SEARCH_COUNTRY=
TREND_SEARCH_LANG=en
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=

# Competitor discovery uses Brave Search for real public profile evidence.
COMPETITOR_SEARCH_COUNTRY=
COMPETITOR_SEARCH_LANG=en

# Competitor refresh uses Apify for real public Instagram data.
# APIFY_INSTAGRAM_ACTOR_ID is for posts; profile scraper is hardcoded as apify/instagram-profile-scraper
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
COMPETITOR_POST_LIMIT=12
HASHTAG_PROVIDER=auto
HASHTAG_SCRAPE_LIMIT=24
HASHTAG_REFRESH_DAYS=7

# Meta Graph hashtag search/top/recent media.
# Requires Facebook Login for Business + Instagram Public Content Access.
# Use a Facebook Graph access token, not the Instagram Login IGAA token.
META_HASHTAG_ACCESS_TOKEN=
META_HASHTAG_IG_USER_ID=
META_FACEBOOK_GRAPH_BASE=https://graph.facebook.com

# Instagram Messaging API / Inbox replies.
# This is separate from the IGAA Instagram Login token. Use a Page/Business
# access token with Instagram messaging permissions when you enable DM inbox.
META_MESSAGING_PAGE_ACCESS_TOKEN=
META_MESSAGING_IG_USER_ID=

# ---------------------------------------------------------------------
# Meta OAuth (Graph API v19) -- optional, Phase 5
# ---------------------------------------------------------------------
# When ALL of META_APP_ID, META_APP_SECRET and TOKEN_ENCRYPTION_KEY are set,
# /api/oauth/meta/init switches from mock to live Graph v19 OAuth. Missing any
# of them keeps the backend in mock mode and the Connect buttons visible in
# /connections will call the mock providers instead.
#
# 1. Create a Meta for Developers app:
#    https://developers.facebook.com/apps/
# 2. Add the redirect URI below to "Facebook Login -> Valid OAuth Redirect URIs"
#    (typically http://localhost:4000/api/oauth/meta/callback for local dev).
# 3. Add your tester Facebook account under "App Roles -> Roles" before going
#    live so the login dialog does not 403.
# 4. Generate a strong random value for TOKEN_ENCRYPTION_KEY -- at least 32
#    bytes entropy. Rotating it invalidates all stored tokens.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/oauth/meta/callback
META_GRAPH_VERSION=v19.0

# Symmetric key used to AES-256-GCM encrypt OAuth access/refresh tokens at rest.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Where /api/oauth/meta/callback redirects the user after the OAuth dance.
FRONTEND_URL=http://localhost:3000

# Demo authentication seed used by `npm run seed:born2hike-auth`
# and the dev-only POST /api/auth/bootstrap-born2hike endpoint.
BORN2HIKE_AUTH_EMAIL=born2hike@smartmena.local
BORN2HIKE_AUTH_PASSWORD=Born2Hike2026!
BORN2HIKE_AUTH_NAME=Born2Hike Demo User
