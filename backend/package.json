{
  "name": "smartmena-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SmartMENA Analytics backend API (Node.js + Express, MVC).",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:born2hike-auth": "node scripts/seedBorn2HikeAuth.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:unit": "npm test -- --testPathPatterns=src",
    "test:integration": "TEST_TYPE=integration npm test -- --testPathPatterns=tests/integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "openai": "^4.104.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "nock": "^14.0.15",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
