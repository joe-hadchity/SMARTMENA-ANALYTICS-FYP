/*
 * Theme tokens.
 * HSL triplets (without the hsl() wrapper) so Tailwind's
 * `hsl(var(--token) / <alpha>)` pattern can apply alpha channels.
 */
:root {
  /* ── SmartMENA palette: "Cedar & Brass" — Levantine / Gulf-rooted ────────
   * primary  cedar teal (mosque domes, Lebanon cedars)
   * accent   brass amber (lanterns, market signage) — uses --warning
   * danger   terracotta  (earthen, not lab-red)
   * success  olive-green (date palm, not bootstrap-green)
   * surfaces warm parchment + pure-white cards
   */

  /* surfaces */
  --bg:              38 35% 96%;   /* warm parchment page bg */
  --bg-elevated:     0 0% 100%;    /* nav, modals — pure white */
  --surface:         0 0% 100%;    /* cards — pure white */
  --surface-muted:   38 25% 95%;
  --surface-hover:   38 30% 93%;

  /* borders — warm and subtle, shadows do the depth */
  --border:          38 20% 88%;
  --border-strong:   38 18% 78%;

  /* text — slightly cool ink against warm surfaces */
  --fg:              210 18% 13%;
  --fg-muted:        210 10% 38%;
  --fg-subtle:       210 8% 55%;
  --fg-inverse:      0 0% 100%;

  /* primary — deep cedar teal */
  --primary:         175 50% 28%;
  --primary-fg:      0 0% 100%;
  --primary-soft:    175 30% 92%;
  --primary-hover:   175 55% 22%;

  /* semantic — MENA-native palette, no off-the-shelf greens/reds */
  --success:         150 45% 35%;   /* olive-green */
  --success-soft:    150 30% 92%;
  --warning:         38 90% 50%;    /* brass amber — also our warm accent */
  --warning-soft:    38 80% 92%;
  --danger:          15 70% 48%;    /* terracotta */
  --danger-soft:     15 60% 94%;
  --info:            205 50% 40%;
  --info-soft:       205 40% 92%;

  --ring:            175 50% 35%;

  /* data-viz — cedar → brass → terracotta → olive → ink-violet → sand-gold */
  --viz-1:           175 50% 32%;   /* cedar teal */
  --viz-2:           38 80% 55%;    /* brass */
  --viz-3:           15 65% 50%;    /* terracotta */
  --viz-4:           150 40% 38%;   /* olive */
  --viz-5:           260 35% 50%;   /* ink violet */
  --viz-6:           45 50% 45%;    /* sand gold */

  /* fonts */
  --font-sans:       "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-arabic:     "IBM Plex Sans Arabic", "Noto Sans Arabic", "Tajawal", system-ui, sans-serif;
}

html.dark {
  /* ── Dark mode: deep ink-teal, like night sky over the Gulf ───────── */
  --bg:              200 30% 6%;
  --bg-elevated:     200 25% 9%;
  --surface:         200 22% 11%;
  --surface-muted:   200 20% 14%;
  --surface-hover:   200 18% 17%;

  --border:          200 15% 22%;
  --border-strong:   200 12% 30%;

  --fg:              38 25% 96%;     /* warm cream ink for warmth on dark */
  --fg-muted:        38 12% 70%;
  --fg-subtle:       38 10% 55%;
  --fg-inverse:      210 18% 13%;

  --primary:         175 50% 50%;    /* lifted cedar for contrast */
  --primary-fg:      210 18% 8%;
  --primary-soft:    175 40% 18%;
  --primary-hover:   175 55% 58%;

  --success:         150 45% 50%;
  --success-soft:    150 30% 18%;
  --warning:         38 85% 60%;
  --warning-soft:    38 50% 18%;
  --danger:          15 70% 60%;
  --danger-soft:     15 50% 18%;
  --info:            205 60% 60%;
  --info-soft:       205 50% 18%;

  --ring:            175 50% 55%;

  --viz-1:           175 55% 50%;
  --viz-2:           38 80% 60%;
  --viz-3:           15 65% 58%;
  --viz-4:           150 45% 52%;
  --viz-5:           260 40% 65%;
  --viz-6:           45 60% 58%;
}

html,
body {
  color: hsl(var(--fg));
  background: hsl(var(--bg));
  font-family: var(--font-sans);
  font-feature-settings: "cv11", "ss01";
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html[dir="rtl"] body {
  font-family: var(--font-arabic);
}

/* Remove the jarring colour flash on first paint when switching themes. */
html.color-theme-in-transition,
html.color-theme-in-transition * {
  transition:
    background-color 120ms ease-out,
    border-color 120ms ease-out,
    color 120ms ease-out !important;
}

/* Scrollbar (subtle, webkit only) */
*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
*::-webkit-scrollbar-thumb {
  background: hsl(var(--border-strong));
  border-radius: 8px;
  border: 2px solid transparent;
  background-clip: content-box;
}
*::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--fg-subtle));
  background-clip: content-box;
}
*::-webkit-scrollbar-track {
  background: transparent;
}

/* Global focus ring (keyboard only). */
*:focus {
  outline: none;
}
*:focus-visible {
  outline: 2px solid hsl(var(--ring));
  outline-offset: 2px;
  border-radius: 6px;
}

/* Text selection */
::-moz-selection {
  background: hsl(var(--primary) / 0.2);
  color: hsl(var(--fg));
}
::selection {
  background: hsl(var(--primary) / 0.2);
  color: hsl(var(--fg));
}

/*
 * Component classes. These intentionally read as small "recipes" so page
 * code stays expressive without needing to memorise long utility strings.
 */

@keyframes live-signals-marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .live-signals-track {
    animation: none;
  }
}

