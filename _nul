/*
 * Print styles for /reports/growth and /r/[token].
 *
 * Goals:
 *   - Hide the app shell (sidebar, topbar, dock) and any control with the
 *     `.no-print` class.
 *   - Let the report body span the full page, avoid awkward page breaks
 *     inside cards, and render borders subtly.
 */
@media print {
  html,
  body {
    background: #fff !important;
    color: #111 !important;
  }

  .no-print,
  aside,
  nav,
  header,
  [data-insights-dock],
  [data-sonner-toaster] {
    display: none !important;
  }

  main {
    padding: 0 !important;
  }

  .report-surface {
    max-width: none !important;
  }

  .report-surface > * {
    -moz-column-break-inside: avoid;
         break-inside: avoid;
    page-break-inside: avoid;
  }

  .report-surface .rounded-xl,
  .report-surface .rounded-lg,
  .report-surface .rounded-md {
    border-radius: 6px !important;
  }

  .report-surface table {
    page-break-inside: auto;
  }

  a[href]::after {
    content: "";
  }
}
